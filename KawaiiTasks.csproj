<!-- Подключение стандартной системы сборки проектов .NET (Microsoft.NET.Sdk). -->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- Группа основных настроек проекта. -->
  <PropertyGroup>

    <!-- Указывает, что проект является исполняемым приложением, а не библиотекой. -->
    <OutputType>Exe</OutputType>

    <!-- Определяет целевую платформу: .NET 8.0. -->
    <TargetFramework>net8.0</TargetFramework>

    <!-- Автоматически подключает стандартные пространства имён .NET,
         чтобы не пришлось вручную добавлять директивы using для них. -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Включает проверку nullable-типов, помогая обнаруживать возможные ошибки,
         связанные с использованием значений null. -->
    <Nullable>enable</Nullable>

    <!-- Задаёт корневое пространство имён проекта. -->
    <RootNamespace>KawaiiTasks</RootNamespace>

    <!-- Задаёт имя итоговой сборки приложения (KawaiiTasks.dll или KawaiiTasks.exe). -->
    <AssemblyName>KawaiiTasks</AssemblyName>

  <!-- Закрывает группу основных настроек проекта. -->
  </PropertyGroup>

  <!-- Группа подключаемых внешних библиотек и зависимостей. -->
  <ItemGroup>

    <!-- Подключает библиотеку Spectre.Console версии 0.49.1,
         которая используется для оформления консольного интерфейса:
         таблиц, цветов, меню и других визуальных элементов. -->
    <PackageReference Include="Spectre.Console" Version="0.49.1" />

  <!-- Закрывает группу подключаемых библиотек. -->
  </ItemGroup>

  <!--
    Юнит-тесты находятся в отдельной папке Tests и имеют собственный файл проекта.
    По умолчанию .NET SDK автоматически включает C#-файлы из вложенных папок.
    Поэтому файлы тестового проекта необходимо исключить из сборки основного приложения,
    чтобы тесты не компилировались вместе с программой.
  -->

  <!-- Группа правил включения и исключения файлов проекта. -->
  <ItemGroup>

    <!-- Исключает все C#-файлы из папки Tests и её вложенных папок.
         Это предотвращает повторную компиляцию тестового кода в основном проекте. -->
    <Compile Remove="Tests/**" />

    <!-- Исключает встроенные ресурсы из папки Tests,
         чтобы ресурсы тестового проекта не попадали в основную сборку. -->
    <EmbeddedResource Remove="Tests/**" />

    <!-- Исключает файлы папки Tests из списка обычных файлов проекта,
         чтобы они не обрабатывались как содержимое основного приложения. -->
    <None Remove="Tests/**" />

  <!-- Закрывает группу правил включения и исключения файлов. -->
  </ItemGroup>

<!-- Закрывает основной элемент проекта. -->
</Project>