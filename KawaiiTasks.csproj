<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KawaiiTasks</RootNamespace>
    <AssemblyName>KawaiiTasks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <!--
    Юнит-тесты лежат в папке Tests со своим проектом. По умолчанию SDK подключает ВСЕ .cs-файлы
    во вложенных папках, поэтому тесты (и их служебные файлы из Tests/obj) нужно явно исключить,
    иначе приложение попытается скомпилировать их вместе с собой.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
